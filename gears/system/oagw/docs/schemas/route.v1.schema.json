{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "cors": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "allow_credentials": {
            "const": true
          }
        },
        "required": [
          "allow_credentials"
        ]
      },
      "properties": {
        "allow_credentials": {
          "default": false,
          "description": "Allow credentials (cookies, auth headers). Requires specific origins (not '*').",
          "type": "boolean"
        },
        "allowed_methods": {
          "default": [
            "GET",
            "POST"
          ],
          "description": "Allowed HTTP methods.",
          "items": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH",
              "HEAD",
              "OPTIONS"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "allowed_origins": {
          "description": "Allowed origins. Use ['*'] for any origin (not recommended with credentials).",
          "items": {
            "oneOf": [
              {
                "const": "*"
              },
              {
                "format": "uri"
              }
            ],
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": false,
          "description": "Enable CORS for this route.",
          "type": "boolean"
        },
        "expose_headers": {
          "default": [],
          "description": "Headers exposed to browser (beyond CORS-safelisted headers).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sharing": {
          "default": "private",
          "description": "Sharing mode for CORS configuration.",
          "enum": [
            "private",
            "inherit",
            "enforce"
          ],
          "type": "string"
        }
      },
      "then": {
        "not": {
          "properties": {
            "allowed_origins": {
              "contains": {
                "const": "*"
              }
            }
          }
        }
      },
      "type": "object"
    },
    "grpc_match": {
      "additionalProperties": false,
      "description": "gRPC match rules (used when the upstream protocol is gRPC).",
      "properties": {
        "method": {
          "description": "RPC method name (e.g., 'GetUser').",
          "minLength": 1,
          "type": "string"
        },
        "service": {
          "description": "Fully qualified gRPC service name (e.g., 'foo.v1.UserService').",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "service",
        "method"
      ],
      "type": "object"
    },
    "http_match": {
      "additionalProperties": false,
      "description": "HTTP match rules (used when the upstream protocol is HTTP).",
      "properties": {
        "methods": {
          "description": "HTTP methods supported by this route.",
          "items": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "path": {
          "description": "Path pattern for the route.",
          "minLength": 1,
          "type": "string"
        },
        "path_suffix_mode": {
          "default": "append",
          "description": "How to treat /{path_suffix} from the proxy URL. 'disabled' rejects path_suffix usage; 'append' appends it to path.",
          "enum": [
            "disabled",
            "append"
          ],
          "type": "string"
        },
        "query_allowlist": {
          "default": [],
          "description": "White-listed query parameters. If empty, allow none.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "methods",
        "path"
      ],
      "type": "object"
    },
    "plugin_binding": {
      "description": "One plugin of the chain together with the configuration it runs under.",
      "properties": {
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "String key/value pairs defined by the plugin being bound.",
          "type": "object"
        },
        "plugin_ref": {
          "description": "Plugin being bound, as a full GTS identifier `gts.cf.core.oagw.{type}_plugin.v1~…`; see DESIGN's plugin identification model.",
          "format": "gts-identifier",
          "type": "string"
        }
      },
      "required": [
        "plugin_ref"
      ],
      "type": "object"
    },
    "rate_limit": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "default": "token_bucket",
          "description": "Rate limiting algorithm. token_bucket allows bursts; sliding_window prevents boundary bursts.",
          "enum": [
            "token_bucket",
            "sliding_window"
          ],
          "type": "string"
        },
        "budget": {
          "description": "Budget descendants draw on; the sum of the child allocations is bounded by it.",
          "properties": {
            "mode": {
              "default": "unlimited",
              "description": "unlimited: no budget tracking; allocated: parent allocates a fixed budget to children; shared: children share the parent's budget.",
              "enum": [
                "unlimited",
                "allocated",
                "shared"
              ],
              "type": "string"
            },
            "overcommit_ratio": {
              "default": 1.0,
              "description": "How far the sum of child allocations may exceed `total`.",
              "maximum": 2.0,
              "minimum": 1.0,
              "type": "number"
            },
            "total": {
              "description": "Total tokens the parent allocates across its descendants.",
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "burst": {
          "properties": {
            "capacity": {
              "description": "Maximum burst size (bucket capacity). Defaults to sustained.rate if not specified.",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "capacity"
          ],
          "type": "object"
        },
        "cost": {
          "default": 1,
          "description": "Tokens consumed per request. Useful for weighted endpoints.",
          "minimum": 1,
          "type": "integer"
        },
        "response_headers": {
          "default": true,
          "description": "Include the `X-RateLimit-*` headers in responses.",
          "type": "boolean"
        },
        "scope": {
          "default": "tenant",
          "description": "Scope for rate limit counters.",
          "enum": [
            "global",
            "tenant",
            "user",
            "ip",
            "route"
          ],
          "type": "string"
        },
        "sharing": {
          "default": "private",
          "description": "Sharing mode for rate limits. enforce: descendants cannot exceed this limit.",
          "enum": [
            "private",
            "inherit",
            "enforce"
          ],
          "type": "string"
        },
        "strategy": {
          "default": "reject",
          "description": "Behavior when limit exceeded.",
          "enum": [
            "reject",
            "queue",
            "degrade"
          ],
          "type": "string"
        },
        "sustained": {
          "properties": {
            "rate": {
              "description": "Tokens replenished per window.",
              "minimum": 1,
              "type": "integer"
            },
            "window": {
              "default": "second",
              "description": "Time window for sustained rate.",
              "enum": [
                "second",
                "minute",
                "hour",
                "day"
              ],
              "type": "string"
            }
          },
          "required": [
            "rate"
          ],
          "type": "object"
        }
      },
      "required": [
        "sustained"
      ],
      "type": "object"
    }
  },
  "properties": {
    "cors": {
      "$ref": "#/definitions/cors",
      "description": "CORS configuration for the route."
    },
    "enabled": {
      "default": true,
      "description": "Whether this route is enabled. A disabled route is excluded from route matching.",
      "type": "boolean"
    },
    "id": {
      "description": "System-generated unique identifier.",
      "format": "uuid",
      "readOnly": true,
      "type": "string"
    },
    "match": {
      "additionalProperties": false,
      "description": "Protocol-scoped inbound matching rules. Exactly one of {http|grpc} must be present.",
      "oneOf": [
        {
          "required": [
            "http"
          ]
        },
        {
          "required": [
            "grpc"
          ]
        }
      ],
      "properties": {
        "grpc": {
          "$ref": "#/definitions/grpc_match"
        },
        "http": {
          "$ref": "#/definitions/http_match"
        }
      },
      "type": "object"
    },
    "plugins": {
      "properties": {
        "items": {
          "default": [],
          "description": "Plugins bound to this route, applied in order within each plugin type; each item names the plugin by GTS identifier and carries its configuration.",
          "items": {
            "$ref": "#/definitions/plugin_binding"
          },
          "type": "array"
        },
        "sharing": {
          "default": "private",
          "description": "Sharing mode for plugin chain.",
          "enum": [
            "private",
            "inherit",
            "enforce"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "priority": {
      "default": 0,
      "description": "Tie-breaker among an upstream's routes once the longest path prefix has matched. Two enabled routes with the same path, priority and method under one upstream conflict.",
      "type": "integer"
    },
    "rate_limit": {
      "$ref": "#/definitions/rate_limit",
      "description": "Rate limiting configuration for the route."
    },
    "tags": {
      "description": "Flat tags for categorization and discovery.",
      "items": {
        "pattern": "^[a-z0-9_-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "tenant_id": {
      "description": "Tenant that owns this resource. Set by the server.",
      "format": "uuid",
      "readOnly": true,
      "type": "string"
    },
    "upstream_id": {
      "description": "Reference to the upstream service for this route.",
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "upstream_id",
    "match"
  ],
  "title": "OAGW Route",
  "type": "object"
}
