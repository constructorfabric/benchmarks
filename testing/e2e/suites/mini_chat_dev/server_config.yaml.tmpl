# Server config for the mini-chat black-box suite (rendered by conftest.py).
# Placeholders (double-underscore names): HOME, API_PORT, MOCK_PORT, MOCK_AZURE_PORT, PROVIDER_AUTH.
# Users: A and B in tenant T1, C in tenant T2 (static-authn static_tokens).

server:
  home_dir: "__HOME__"

database:
  servers:
    sqlite_mc:
      engine: "sqlite"
      params:
        WAL: "true"
        synchronous: "NORMAL"
        busy_timeout: "5000"
      pool:
        max_conns: 5
        acquire_timeout: "30s"

logging:
  default:
    console_level: info
    file: "__HOME__/logs/server.log"
    file_level: info
  mini_chat:
    console_level: debug
    file: "__HOME__/logs/mini-chat.log"
    file_level: debug

gears:
  api-gateway:
    config:
      bind_addr: "127.0.0.1:__API_PORT__"
      enable_docs: false
      cors_enabled: false
      defaults:
        body_limit_bytes: 64000000
      auth_disabled: false
      require_auth_by_default: true
      rate_limit_zones:
        rl_mini_chat_chat:
          rate_limit: 1000/s
          burst_limit: 1000
          response_status_code: 429
          response_retry_after: auto
          key:
            type: ip
          max_keys: 10000
      in_flight_limit_zones:
        ifl_mini_chat_chat:
          in_flight_limit: 100
          backlog_limit: 0
          backlog_timeout: 0s
          response_status_code: 429
          key:
            type: ip
          max_keys: 10000

  gear-orchestrator:
    config: {}

  grpc-hub:
    config:
      listen_addr: "uds://__HOME__/grpc.sock"

  authn-resolver:
    config:
      vendor: "constructorfabric"

  authz-resolver:
    config:
      vendor: "constructorfabric"

  static-authn-plugin:
    config:
      vendor: "constructorfabric"
      priority: 100
      mode: static_tokens
      tokens:
        - token: "mc-token-user-a"
          identity:
            subject_id: "a0000000-0000-4000-8000-00000000000a"
            subject_tenant_id: "10000000-0000-4000-8000-000000000001"
            subject_type: "gts.cf.core.security.subject_user.v1~"
            token_scopes: ["*"]
        - token: "mc-token-user-b"
          identity:
            subject_id: "b0000000-0000-4000-8000-00000000000b"
            subject_tenant_id: "10000000-0000-4000-8000-000000000001"
            subject_type: "gts.cf.core.security.subject_user.v1~"
            token_scopes: ["*"]
        - token: "mc-token-user-c"
          identity:
            subject_id: "c0000000-0000-4000-8000-00000000000c"
            subject_tenant_id: "20000000-0000-4000-8000-000000000002"
            subject_type: "gts.cf.core.security.subject_user.v1~"
            token_scopes: ["*"]
      s2s_credentials:
        - client_id: "mini-chat"
          client_secret: "mini-chat-dev-secret"

  static-authz-plugin:
    config:
      vendor: "constructorfabric"
      priority: 100

  tenant-resolver:
    config:
      vendor: "constructorfabric"

  single-tenant-tr-plugin:
    config:
      vendor: "constructorfabric"

  credstore:
    database:
      server: "sqlite_mc"
      file: "credstore.db"
    config:
      vendor: "constructorfabric"

  static-credstore-plugin:
    config:
      secrets:
        - key: "openai-key"
          value: "sk-mockmockmockmockmock"

  mini-chat:
    database:
      server: "sqlite_mc"
      file: "mini_chat.db"
    config:
      client_credentials:
        client_id: "mini-chat"
        client_secret: "mini-chat-dev-secret"
      streaming:
        sse_ping_interval_seconds: 5
      # Fast scans so the suite can age rows in the DB and observe the workers.
      orphan_watchdog:
        scan_interval_secs: 1
      upload_reaper:
        scan_interval_secs: 1
        stale_after_secs: 60
      providers:
        openai:
          kind: openai_responses
          storage_kind: openai
          host: "127.0.0.1"
          port: __MOCK_PORT__
          use_http: true
          api_path: "/v1/responses"
__PROVIDER_AUTH__
        azure:
          kind: openai_responses
          storage_kind: azure
          host: "127.0.0.1"
          port: __MOCK_AZURE_PORT__
          use_http: true
          api_path: "/openai/v1/responses"
          api_version: "2025-03-01-preview"
  static-mini-chat-audit-plugin:
    config:
      enabled: true

