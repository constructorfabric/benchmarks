# Copy to .env (gitignored). run.sh and the Python entry points read it.
LITELLM_KEY=<the cfs-pr-review key>
LITELLM_ROUTER_V1=http://100.100.123.225:8080/v1
# parallel router requests allowed by the key; every process shares this many slots
ROUTER_MAX_PARALLEL=2
# Claude Code seat tokens (`claude setup-token`), used in this order
CC_TOKEN_2=
CC_TOKEN_3=
CC_TOKEN=
CLAUDE_SEATS=CC_TOKEN_2,CC_TOKEN_3,CC_TOKEN
